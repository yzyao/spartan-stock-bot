TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated user IDs; only these users' private messages are accepted.
# Empty = TELEGRAM_CHAT_ID (single administrator compatibility).
TELEGRAM_ADMIN_IDS=
# Channel audience receives stock messages.
# Leave empty for personal/private notification mode.
TELEGRAM_CHANNEL_ID=
CHECK_INTERVAL_SECONDS=60
HTTP_TIMEOUT_SECONDS=15
FETCH_MODE=browser
BROWSER_TIMEOUT_SECONDS=45
# Empty = Chromium/Chrome discovered automatically; Docker sets /usr/bin/chromium.
# BROWSER_EXECUTABLE=/usr/bin/chromium
# Default profile is browser/ beside STATE_FILE; persists cookies between restarts.
# BROWSER_PROFILE_DIR=/data/browser
# Optional proxy; no credentials in URL. Chrome does not inherit HTTP_PROXY.
# BROWSER_PROXY_URL=http://proxy.example:8080
# Local default false. Docker image sets true inside the non-root isolated container.
# BROWSER_NO_SANDBOX=false
STATE_FILE=/data/state.json
LOG_LEVEL=info
TZ=Asia/Shanghai
SPARTAN_AFFILIATE_ID=1194
# Optional: comma-separated category URLs. Unset = the three built-in Spartan URLs.
# SPARTAN_URLS=https://billing.spartanhost.net/store/cmin2-premium-kvm-vps-seattle
